        "773:             if (Input.GetKey(KeyCode.LeftArrow)) rotation += aimRotationSpeed * Time.deltaTime;",
        "774:             if (Input.GetKey(KeyCode.RightArrow)) rotation -= aimRotationSpeed * Time.deltaTime;",
        "775: ",
        "776:             if (!Mathf.Approximately(rotation, 0f))",

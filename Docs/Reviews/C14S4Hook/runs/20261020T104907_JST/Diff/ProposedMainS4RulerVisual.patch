+        void ApplyCornerHookPresentation()
+        {
+            if (Surface == null) return;
+            if (cornerHook == null)
+                foreach (var root in gameObject.scene.GetRootGameObjects())
+                    if (root.name == MainStageSectionFourSetup.BridgeAnchorName) cornerHook = root;
+            if (cornerHook == null) return;
+            var ring = cornerHook.GetComponentInChildren<RopeAnchorRingVisual>();
+            if (ring == null) return;
+            var renderer = ring.GetComponent<SpriteRenderer>();
+            // The ruler face is order 7, while the legacy ring is order 6.
+            // Keep this one ring and its existing mounting hardware in front.
+            int front = Surface.sortingOrder + 5;
+            if (renderer.sortingLayerID != Surface.sortingLayerID || renderer.sortingOrder != front)
+                ring.Configure(Surface.sortingLayerID, front);
+            var mount = ring.transform.Find("Wood And Yarn Hook Mount");
+            if (mount == null) return;
+            // Reuse the same plate, pins and tie as a diagonal corner fixing.
+            // Only decoration rotates: the ring/HookPoint/rope endpoint stay put.
+            mount.localRotation = Quaternion.Euler(0, 0, -135f);
+            if (cornerMount == mount) return;
+            cornerMount = mount;
+            foreach (string part in new[] { "Mount Soft Shadow", "Wooden Mount", "Left Wooden Pin", "Right Wooden Pin" })
+            {
+                Transform hardware = mount.Find(part);
+                if (hardware != null) hardware.localPosition += Vector3.up * .15f;
+            }
